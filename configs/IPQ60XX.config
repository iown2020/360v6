# ==============================================
# 360V6 专属配置（已修复内核编译错误）
# ==============================================

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_qihoo_360v6=y
CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_USE_MUSL=y
CONFIG_NSS_FIRMWARE_VERSION_11_4=y

CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-wifi=y
CONFIG_MAC80211_NSS_REDIRECT=y

CONFIG_IPV6=n
CONFIG_KERNEL_DEBUG=n
CONFIG_KERNEL_DEBUG_INFO=n
CONFIG_NET_SCHED=n

CONFIG_TARGET_ROOTFS_UBIFS=y
CONFIG_TARGET_UBIFS_COMPRESSION_LZO=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=480

# ======================
# 修复编译错误（必须）
# ======================
CONFIG_NF_CONNTRACK_DSCPREMARK_EXT=n
CONFIG_NETFILTER_EGRESS=n
CONFIG_NF_CONNTRACK_PROCFS=y
